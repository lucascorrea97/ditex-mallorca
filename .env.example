# Copy to .env and fill in. .env is gitignored.

# Canonical public origin for SEO (canonical URLs, hreflang, sitemap, JSON-LD) — ADR-0004.
# Defaults to the .es we control; set to https://ditexmallorca.com after recovery to flip
# canonical cleanly (no code change). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://ditexmallorca.es"

# Postgres connection string.
# Local dev (matches docker-compose.yml):
DATABASE_URL="postgres://postgres:postgres@localhost:5432/ditex"
# Production: a managed Postgres (Neon / Vercel Postgres / Supabase) — ADR-0007.

# Auth.js (next-auth v5) — ADR-0007. Required in production.
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Shared Client Area password. Handed out to authorised clients.
# In production, use a strong random value and rotate periodically.
CLIENT_AREA_PASSWORD=""

# Admin back-office password — gates /admin (ADR-0007). Single internal editor for now.
# Keep distinct from CLIENT_AREA_PASSWORD; use a strong random value in production.
ADMIN_PASSWORD=""

# Parity mode — Milestone M0 (ADR-0021, issue #83). When ON (the default), the site
# MATCHES the current ditexmallorca.es and HIDES what it lacks: the /catalogo browse
# experience, /guias, and the request/enquiry flow (area-clientes/solicitud) are
# removed from nav/footer/sitemap and blocked at the route level. No code is deleted.
# Set to "false" (or "0") to restore the full site for the eventual big-bang launch.
# Unset = ON.
NEXT_PUBLIC_PARITY_MODE="true"

# Vercel Blob — the private "ditex-documents" store holding the Client Area PDFs
# (#84, ADR-0007 2026-09-01). The files are NOT in git or /public: /public is served
# with no auth, which would defeat the gated Client Area. They are served only by
# app/api/client-docs/[doc]/route.ts, behind the session check.
#
# The store is OIDC-only — there is deliberately NO long-lived BLOB_READ_WRITE_TOKEN.
# On Vercel, BLOB_STORE_ID + VERCEL_OIDC_TOKEN are injected automatically. Locally,
# run `vercel link && vercel env pull` to write them into .env.local (gitignored);
# re-run it when the OIDC token expires. Uploading is a one-time local job:
# `npm run docs:upload` (never through a function — Vercel caps bodies at 4.5 MB).
BLOB_STORE_ID=""
